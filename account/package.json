{
  "name": "starlit-account",
  "private": true,
  "version": "0.1.0",
  "description": "Starlit account and sync dashboard (separate origin, no runtime dependencies)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:live": "node build.mjs --mode=live",
    "preview": "node tools/preview.mjs",
