    "e2e": "playwright test",
    "e2e:live": "playwright test --project=live"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
