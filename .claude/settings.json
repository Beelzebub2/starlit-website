{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/check-freshness.mjs --mode=session",
            "timeout": 25000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/check-freshness.mjs --mode=check",
            "timeout": 25000
          }
        ]
      }
    ]
  }
}
